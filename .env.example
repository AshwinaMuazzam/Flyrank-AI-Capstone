# Movie data (free key from https://www.omdbapi.com/apikey.aspx — activate it via the email link)
VITE_OMDB_API_KEY=your_omdb_key

# AI suggestions — FREE key from https://aistudio.google.com/apikey (no credit card needed).
# Server-side only: NO "VITE_" prefix, so it is never bundled into the browser code.
GEMINI_API_KEY=your_gemini_key
# Optional. Defaults to gemini-flash-latest (Google's current free-tier Flash model).
# GEMINI_MODEL=
